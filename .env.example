# Environment variables read at startup (export them or set them in the hosting platform)
SECRET_KEY=change-me
# Path to the trained weights; defaults to models/ocular_disease_model.h5
ODR_MODEL_PATH=models/ocular_disease_model.h5
# auto = demo predictions when weights are missing, on = always demo, off = fail without a model
ODR_DEMO_MODE=auto
# DATABASE_URL=sqlite:///instance/ocular.db
